# Copy this file to .env and fill in your keys:
#
#   cp .env.example .env
#
# The bot loads .env automatically at startup (via python-dotenv).
# Exporting these variables in your shell still works exactly as before --
# shell environment variables take precedence over values in .env.
#
# .env is gitignored. Never commit real keys.

# --- LLM API keys (set the ones for the LLMs you use) ---
GOOGLE_API_KEY=your-gemini-key-here
CLAUDE_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
XAI_API_KEY=your-grok-key-here
PERPLEXITY_API_KEY=your-perplexity-key-here

# --- LLM model overrides (optional -- see modelregistry.py / MODELS.md) ---
# Model IDs are hardcoded nowhere else in the codebase; every call site
# reads them through modelregistry.get_model(), which checks these env
# vars first and falls back to the DEFAULT_MODELS registry. Set one of
# these to pin a specific model, or to work around a provider retiring
# the current default without waiting for a code change.
#GEMINI_MODEL=gemini-3.1-pro-preview
#CLAUDE_MODEL=claude-opus-4-8
#OPENAI_MODEL=gpt-5.5
#GROK_MODEL=grok-4.5
#PERPLEXITY_MODEL=sonar-pro

# --- Trading (required for live trading only) ---
# Coinbase credentials JSON file (default: cdp_api_key.json, gitignored)
#COINBASE_CREDENTIALS_FILE=cdp_api_key.json

# --- Optional data providers ---
#LUNARCRUSH_API_KEY=
#COINMARKETCAP_API_KEY=

# --- Optional run configuration (can also be passed as CLI flags) ---
# See OPERATIONS_MANUAL.md for the full list.
#TRADING_MODE=whatif
#LLM_MODE=compare
#PRIMARY_LLM=gemini
#COMPARE_LLMS=gemini,claude,openai
#ANALYZE_COINS=
